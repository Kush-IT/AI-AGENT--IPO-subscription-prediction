# =====================================================================
# Pre-IPO Subscription AI Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your deployment.
# NEVER commit real secret credentials or production API keys to git.
# =====================================================================

# Server Configuration
PROJECT_NAME="IPO Agentic AI"
VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG=false
HOST="0.0.0.0"
PORT=8000

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed frontend origins
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# Data Connector & Execution Configuration
DEFAULT_CONNECTOR_MODE="OFFLINE"
ENABLE_LIVE_CRAWLERS=false
CACHE_TTL_HOURS=24

# Frontend Configuration (Used when building React application)
VITE_API_BASE_URL="http://localhost:8000"
